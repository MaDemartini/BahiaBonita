                        &lt;li class=&quot;nav-item&quot;&gt;&lt;a class=&quot;nav-link fw-semibold&quot;
                                href=&quot;/servicios&quot;&gt;Servicios&lt;/a&gt;&lt;/li&gt;
                        &lt;li class=&quot;nav-item&quot;&gt;&lt;a class=&quot;nav-link fw-semibold&quot;
                                href=&quot;/departamentos&quot;&gt;Departamentos&lt;/a&gt;&lt;/li&gt;
                    &lt;/ul&gt;

                    &lt;!-- Botones separados --&gt;
                    &lt;div class=&quot;d-flex align-items-center gap-2&quot;&gt;
                        &lt;a href=&quot;/departamentos&quot;
                            class=&quot;btn btn-primary px-4 fw-semibold btn_reserva&quot;&gt;Reservar&lt;/a&gt;
