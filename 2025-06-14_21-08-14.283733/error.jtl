        &lt;link rel=&quot;stylesheet&quot; href=&quot;/static/css/api.css&quot; /&gt;
    &lt;/head&gt;
    &lt;body class=&quot;bg-white text-dark&quot;&gt;

        &lt;nav
            class=&quot;navbar navbar-expand-lg navbar-light bg-light shadow-sm py-3&quot;&gt;
            &lt;div class=&quot;container&quot;&gt;
                &lt;a class=&quot;navbar-brand fw-bold fs-3&quot; href=&quot;/&quot;&gt;Bahía Bonita&lt;/a&gt;
                &lt;button class=&quot;navbar-toggler&quot; type=&quot;button&quot;
                    data-bs-toggle=&quot;collapse&quot; data-bs-target=&quot;#navbarNav&quot;
                    aria-controls=&quot;navbarNav&quot; aria-expanded=&quot;false&quot;
                    aria-label=&quot;Toggle navigation&quot;&gt;
                    &lt;span class=&quot;navbar-toggler-icon&quot;&gt;&lt;/span&gt;
                &lt;/button&gt;
                &lt;div class=&quot;collapse navbar-collapse&quot; id=&quot;navbarNav&quot;&gt;
                    &lt;!-- Links normales --&gt;
                    &lt;ul class=&quot;navbar-nav me-auto mb-2 mb-lg-0 gap-3&quot;&gt;
                        &lt;li class=&quot;nav-item&quot;&gt;&lt;a class=&quot;nav-link fw-semibold&quot;
                                href=&quot;/&quot;&gt;Inicio&lt;/a&gt;&lt;/li&gt;
                        &lt;li class=&quot;nav-item&quot;&gt;&lt;a class=&quot;nav-link fw-semibold&quot;
                                href=&quot;/servicios&quot;&gt;Servicios&lt;/a&gt;&lt;/li&gt;
                        &lt;li class=&quot;nav-item&quot;&gt;&lt;a class=&quot;nav-link fw-semibold&quot;
                                href=&quot;/departamentos&quot;&gt;Departamentos&lt;/a&gt;&lt;/li&gt;
                    &lt;/ul&gt;

                    &lt;!-- Botones separados --&gt;
                    &lt;div class=&quot;d-flex align-items-center gap-2&quot;&gt;
                        &lt;a href=&quot;/departamentos&quot;
                            class=&quot;btn btn-primary px-4 fw-semibold btn_reserva&quot;&gt;Reservar&lt;/a&gt;
                        &lt;a href=&quot;/contacto&quot;
                            class=&quot;btn btn-outline-primary px-4 fw-semibold&quot;&gt;Contacto&lt;/a&gt;
                        
                        &lt;a href=&quot;/registro/&quot;
                            class=&quot;btn btn-outline-secondary px-4 fw-semibold&quot;&gt;Registro&lt;/a&gt;
                        &lt;a href=&quot;/login/&quot;
                            class=&quot;btn btn-outline-secondary px-4 fw-semibold&quot;&gt;Iniciar
                            Sesión&lt;/a&gt;
                        

                        &lt;a
                            href=&quot;https://wa.me/56930956242?text=Hola%2C%20vi%20su%20sitio%20web%20Bah%C3%ADa%20Bonita%20y%20me%20gustar%C3%ADa%20hacer%20una%20reserva.%20%C2%BFPodr%C3%ADa%20orientarme%20con%20la%20disponibilidad%20y%20tarifas%3F&quot;
                            target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;
                            &lt;button class=&quot;bb-btn&quot;
                                aria-label=&quot;Contacto WhatsApp&quot;&gt;
                                &lt;span class=&quot;bb-svg-container&quot;&gt;
                                    &lt;svg viewBox=&quot;0 0 16 16&quot; height=&quot;2.5em&quot;
