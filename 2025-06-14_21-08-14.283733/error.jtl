    <responseData class="java.lang.String">&lt;!DOCTYPE html&gt;
&lt;html&gt;
  &lt;head&gt;
    &lt;style type=&quot;text/css&quot;&gt;
      html, body, #mapDiv {
        height: 100%;
        margin: 0;
        padding: 0;
      }
    &lt;/style&gt;
  &lt;/head&gt;
  &lt;body&gt;
    &lt;div id=&quot;mapDiv&quot;&gt;&lt;/div&gt;
      
