&lt;!-- Sección de Bienvenida --&gt;
&lt;div class=&quot;text-center mb-5&quot;&gt;
    &lt;h1 class=&quot;display-4 fw-bold&quot;&gt;Bienvenidos a Bahía Bonita&lt;/h1&gt;
    &lt;p class=&quot;lead fst-italic&quot;&gt;Tu mejor opción para hospedarte frente al mar&lt;/p&gt;
    &lt;hr class=&quot;w-25 mx-auto&quot;&gt;
&lt;/div&gt;

&lt;div class=&quot;container my-5&quot; id=&quot;inicio&quot;&gt;
    &lt;div class=&quot;row align-items-center gy-4&quot;&gt;
        &lt;div class=&quot;col-md-6&quot;&gt;
            &lt;p class=&quot;fs-5&quot;&gt;
                Disfruta de una experiencia única en nuestros departamentos, donde la tranquilidad y el servicio excepcional se combinan para ofrecerte unas vacaciones inolvidables. ¡Ven y descubre el paraíso!
            &lt;/p&gt;
        &lt;/div&gt;
        &lt;div class=&quot;col-md-6 text-center&quot;&gt;
            &lt;img src=&quot;/static/img/imagen4.png&quot; class=&quot;img-fluid rounded shadow&quot; alt=&quot;Hotel Bahía Bonita&quot; /&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Sección Clima Mejorada --&gt;
&lt;section class=&quot;my-5 p-4 bg-light rounded shadow-sm&quot;&gt;
    



&lt;div class=&quot;container my-5&quot;&gt;
  &lt;!-- Título principal --&gt;
  &lt;h2 class=&quot;mb-4 text-center&quot;&gt;Pronóstico del Clima&lt;/h2&gt;

  &lt;!-- Clima actual --&gt;
  &lt;div id=&quot;weather-current&quot; class=&quot;p-4 border rounded shadow-sm mb-5 bg-light&quot;&gt;
    &lt;h4 class=&quot;mb-3&quot;&gt;Clima Actual - Concón&lt;/h4&gt;
    &lt;div class=&quot;d-flex align-items-center gap-4&quot;&gt;
      &lt;img id=&quot;weather-icon&quot; src=&quot;&quot; alt=&quot;Icono clima&quot; style=&quot;width:100px;&quot;&gt;
      &lt;div&gt;
        &lt;p id=&quot;weather-description&quot; class=&quot;mb-1 text-capitalize&quot;&gt;Cargando...&lt;/p&gt;
        &lt;p class=&quot;mb-1&quot;&gt;Temperatura: &lt;span id=&quot;weather-temp&quot;&gt;--&lt;/span&gt;&lt;/p&gt;
        &lt;p class=&quot;mb-0&quot;&gt;Mín: &lt;span id=&quot;temp-min&quot;&gt;--&lt;/span&gt; / Máx: &lt;span id=&quot;temp-max&quot;&gt;--&lt;/span&gt;&lt;/p&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;!-- Pronóstico de 7 días --&gt;
  &lt;div id=&quot;weather-forecast&quot;&gt;
    &lt;h4 class=&quot;mb-3&quot;&gt;Pronóstico 5 Días&lt;/h4&gt;
    &lt;div id=&quot;weather-container&quot; class=&quot;d-flex flex-nowrap gap-3 overflow-auto&quot;&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;script src=&quot;/static/js/clima.js&quot;&gt;&lt;/script&gt;


&lt;/section&gt;

&lt;!-- Servicios --&gt;
&lt;div class=&quot;row text-center my-5 gy-4&quot;&gt;
    &lt;div class=&quot;col-md-6 col-sm-12&quot;&gt;
        &lt;div class=&quot;card h-100 shadow rounded-4&quot;&gt;
            &lt;img src=&quot;/static/img/estacionamiento.jpeg&quot; class=&quot;card-img-top rounded-top-4&quot; alt=&quot;Estacionamiento&quot; style=&quot;height: 250px; object-fit: cover;&quot;&gt;
            &lt;div class=&quot;card-body&quot;&gt;
                &lt;h5 class=&quot;card-title fw-semibold&quot;&gt;Estacionamiento&lt;/h5&gt;
                &lt;p class=&quot;card-text text-muted&quot;&gt;Disfruta de estacionamiento seguro&lt;/p&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class=&quot;col-md-6 col-sm-12&quot;&gt;
        &lt;div class=&quot;card h-100 shadow rounded-4&quot;&gt;
            &lt;img src=&quot;/static/img/comodidad.jpeg&quot; class=&quot;card-img-top rounded-top-4&quot; alt=&quot;Comodidad&quot; style=&quot;height: 250px; object-fit: cover;&quot;&gt;
            &lt;div class=&quot;card-body&quot;&gt;
                &lt;h5 class=&quot;card-title fw-semibold&quot;&gt;Comodidad Total&lt;/h5&gt;
                &lt;p class=&quot;card-text text-muted&quot;&gt;Departamentos equipados con todo lo necesario para tu descanso.&lt;/p&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class=&quot;col-md-6 col-sm-12&quot;&gt;
        &lt;div class=&quot;card h-100 shadow rounded-4&quot;&gt;
            &lt;img src=&quot;/static/img/ubicacionprivilegiada.jpeg&quot; class=&quot;card-img-top rounded-top-4&quot; alt=&quot;Ubicación&quot; style=&quot;height: 250px; object-fit: cover;&quot;&gt;
            &lt;div class=&quot;card-body&quot;&gt;
                &lt;h5 class=&quot;card-title fw-semibold&quot;&gt;Ubicación Privilegiada&lt;/h5&gt;
                &lt;p class=&quot;card-text text-muted&quot;&gt;Frente a la playa y cerca de los principales atractivos turísticos.&lt;/p&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class=&quot;col-md-6 col-sm-12&quot;&gt;
        &lt;div class=&quot;card h-100 shadow rounded-4&quot;&gt;
            &lt;img src=&quot;/static/img/piscina.jpeg&quot; class=&quot;card-img-top rounded-top-4&quot; alt=&quot;Piscina&quot; style=&quot;height: 250px; object-fit: cover;&quot;&gt;
            &lt;div class=&quot;card-body&quot;&gt;
                &lt;h5 class=&quot;card-title fw-semibold&quot;&gt;Piscina Incluida&lt;/h5&gt;
                &lt;p class=&quot;card-text text-muted&quot;&gt;Acceso a nuestra piscina para toda la familia.&lt;/p&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Mapa con dirección al lado --&gt;
&lt;div class=&quot;container my-5&quot;&gt;
    &lt;h3 class=&quot;mb-4 fw-semibold text-center&quot;&gt;Nuestra Ubicación&lt;/h3&gt;
    &lt;hr class=&quot;w-25 mx-auto&quot;&gt;
