{
 "execution": [
  {
   "concurrency": 50,
   "iterations": 1,
   "ramp-up": "10s",
   "hold-for": "1m",
   "scenario": "prueba_local"
  }
 ],
 "scenarios": {
  "prueba_local": {
   "requests": [
    {
     "url": "http://127.0.0.1:8000/",
     "method": "GET"
    }
   ]
  }
 },
 "reporting": [
  {
   "module": "final-stats"
  },
  {
   "module": "console"
  },
  {
   "module": "junit-xml",
   "filename": "resultados_test_50_usuarios.xml"
  }
 ]
}
