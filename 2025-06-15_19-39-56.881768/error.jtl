                        &lt;a
                            href=&quot;https://wa.me/56930956242?text=Hola%2C%20vi%20su%20sitio%20web%20Bah%C3%ADa%20Bonita%20y%20me%20gustar%C3%ADa%20hacer%20una%20reserva.%20%C2%BFPodr%C3%ADa%20orientarme%20con%20la%20disponibilidad%20y%20tarifas%3F&quot;
                            target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;
                            &lt;button class=&quot;bb-btn&quot;
                                aria-label=&quot;Contacto WhatsApp&quot;&gt;
                                &lt;span class=&quot;bb-svg-container&quot;&gt;
                                    &lt;svg viewBox=&quot;0 0 16 16&quot; height=&quot;2.5em&quot;
