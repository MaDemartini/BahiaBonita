        &lt;main class=&quot;container my-5&quot;&gt;
            
&lt;div id=&quot;carouselExampleIndicators&quot; class=&quot;carousel slide mb-5&quot; data-bs-ride=&quot;carousel&quot;&gt;
    &lt;div class=&quot;carousel-inner rounded-4 shadow-sm overflow-hidden&quot;&gt;
        &lt;div class=&quot;carousel-item active&quot;&gt;
            &lt;img src=&quot;/static/img/imagen1.png&quot; class=&quot;d-block w-100&quot; alt=&quot;Playa&quot;&gt;
        &lt;/div&gt;
        &lt;div class=&quot;carousel-item&quot;&gt;
            &lt;img src=&quot;/static/img/imagen2.png&quot; class=&quot;d-block w-100&quot; alt=&quot;Departamento 1&quot;&gt;
        &lt;/div&gt;
        &lt;div class=&quot;carousel-item&quot;&gt;
            &lt;img src=&quot;/static/img/imagen3.png&quot; class=&quot;d-block w-100&quot; alt=&quot;Piscina&quot;&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;button class=&quot;carousel-control-prev&quot; type=&quot;button&quot; data-bs-target=&quot;#carouselExampleIndicators&quot; data-bs-slide=&quot;prev&quot;&gt;
